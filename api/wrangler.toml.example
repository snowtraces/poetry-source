name = "poetry-source-api"
main = "src/index.mjs"
compatibility_date = "2026-08-07"

[vars]
ALLOWED_ORIGIN = "*"

# Use a unique positive integer for this Cloudflare account.
[[ratelimits]]
name = "IP_RATE_LIMITER"
namespace_id = "2026081201"

  [ratelimits.simple]
  limit = 60
  period = 60

[[d1_databases]]
binding = "DB"
database_name = "poetry-source"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"
